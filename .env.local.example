# Copy to `.env.local` and fill in. `.env.local` is gitignored and never committed.
#
# Where each value comes from, in the Supabase dashboard for project
# iqpmrluvlsgoihwyibey (https://supabase.com/dashboard/project/iqpmrluvlsgoihwyibey):

# Settings -> API -> Project URL. Not secret; the browser uses it.
NEXT_PUBLIC_SUPABASE_URL=https://iqpmrluvlsgoihwyibey.supabase.co

# Settings -> API Keys -> `publishable` (or the legacy `anon` key).
# Not secret either: it only ever reaches the database through RLS, which is why
# the grants had to become real policies rather than a hidden tab.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Settings -> API Keys -> `secret` (or the legacy `service_role` key).
# SECRET. Bypasses RLS entirely. Server-side only: the ingest route writes uploaded
# rows with it, and it must never be sent to a browser or put in a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL. Settings -> Database -> Connection string -> URI, password filled in.
#
# Nothing requires this. The refresh worker reads the raw tables and writes a build
# through PostgREST with the service-role key above, which needs no Postgres port open
# and works from a GitHub Actions runner without an IPv4 add-on. Direct psql access is
# a convenience for ad-hoc queries, not a dependency.
#
# As of 10 Aug 2026 this project would not accept one: db.<ref>.supabase.co refuses the
# connection, and every shared pooler region answers "tenant/user postgres.<ref> not
# found", while the same database serves the REST API normally.
# SECRET.
SUPABASE_DB_URL=

# Settings -> General -> Reference ID. Not secret.
SUPABASE_PROJECT_REF=iqpmrluvlsgoihwyibey
